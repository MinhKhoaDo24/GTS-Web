# ──────────────────────────────────────────────
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên git
# ──────────────────────────────────────────────

# PostgreSQL (dùng cho docker-compose)
POSTGRES_USER=gts_user
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=gts_db

# Database URL (web container kết nối tới postgres container)
DATABASE_URL="postgresql://gts_user:your_strong_password_here@postgres:5432/gts_db"

# NextAuth Authentication
# Tạo secret mạnh: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"

# URL thật của server (VD: https://gts.com.vn)
NEXTAUTH_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
